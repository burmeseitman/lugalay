# ── things that are far too big, or rebuild themselves ──
agent/voice/.venv/
agent/voice/models/
agent/.convert-venv/
__pycache__/
*.pyc

# ── generated at runtime ──
agent/logs/
agent/bus/state.json
agent/bus/face.json
agent/hands/state/

# ── personal: created by setup, belongs to whoever installs this ──
CLAUDE.md
memory/
*.before-setup
.setup-test-backup/
old-terminal-shortcuts/
*.ses

# ── build output (PyInstaller writes these) ──
/build/
/dist/

# ── macOS ──
.DS_Store

# personal: seeded from config.default.json on first run
agent/config.json

# generated at build time
packaging/icon.icns
packaging/icon.ico
packaging/icon.png
packaging/*.iconset/

# generated at runtime
agent/eyes/frames/

# ── secrets and credentials — never commit these ──
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
tokens.json

# ── local tool config ──
.claude/
.venv/
venv/
env/
